# Copiar como .env (no se sube al repositorio). Todos los valores son solo para desarrollo local.

# Firma de los tokens de sesión: cámbialo por un texto aleatorio de 32 caracteres o más.
JWT_SECRET=cambia-esto-por-un-secreto-local-de-32-caracteres-o-mas
CORS_ORIGEN=http://localhost:4200
POSTGRES_USER=hampi
POSTGRES_PASSWORD=hampi

PIDE_USUARIO=40000000
PIDE_PASSWORD=clave-entidad
MOCK_LATENCIA_MS=200
PIDE_MOCK_FALLA=false

SMS_API_KEY=clave-sms-local
SMS_MOCK_FALLA=false

# Citas ficticias de cada día para que la demo de admisión nunca esté vacía (false para desactivarlas)
CITAS_DEMO=true
