            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('aparece la cita reservada', () => pm.expect(pm.response.json().map(c => c.codigo)).to.include(pm.collectionVariables.get('codigo')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/mias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas",
                "mias"
              ]
            }
          }
        },
        {
          "name": "Ficha de la cita",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('es la misma cita', () => pm.expect(pm.response.json().codigo).to.eql(pm.collectionVariables.get('codigo')));"
                ]
