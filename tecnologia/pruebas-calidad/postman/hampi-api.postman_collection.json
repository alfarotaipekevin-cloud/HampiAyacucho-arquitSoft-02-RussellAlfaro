{
  "info": {
    "name": "Hampi Ayacucho · API de citas (Sprint 2)",
    "description": "Recorrido de la API REST /api/v1 con pruebas automáticas: identidad, disponibilidad, reserva, reprogramación, cancelación, admisión y seguridad (EQ-04). Se ejecuta en orden con el Runner de Postman o con Newman. Cuentas demo: paciente 70000001 y personal 70000099, contraseña Hampi2026.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api/v1"
    },
    {
      "key": "dniPaciente",
      "value": "70000001"
    },
    {
      "key": "dniPersonal",
      "value": "70000099"
    },
    {
      "key": "contrasena",
      "value": "Hampi2026"
    },
    {
      "key": "especialidadId",
      "value": "ped"
    },
    {
      "key": "establecimientoId",
      "value": "hra"
    }
  ],
  "item": [
    {
      "name": "1. Identidad (spec 002)",
      "item": [
        {
          "name": "Iniciar sesión como paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('EQ-01: responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const r = pm.response.json();",
                  "pm.test('devuelve un JWT con rol PACIENTE', () => { pm.expect(r.token.split('.')).to.have.length(3); pm.expect(r.usuario.rol).to.eql('PACIENTE'); });",
                  "pm.collectionVariables.set('tokenPaciente', r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/identidad/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identidad",
                "sesion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroDocumento\": \"{{dniPaciente}}\",\n  \"contrasena\": \"{{contrasena}}\"\n}"
            }
          }
        },
        {
          "name": "Contraseña incorrecta (CA-002-7)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('rechaza con 401', () => pm.response.to.have.status(401));",
                  "pm.test('no expone datos internos', () => pm.expect(pm.response.text()).to.not.match(/stack|SELECT|hash/i));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/identidad/sesion",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identidad",
                "sesion"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numeroDocumento\": \"70000002\",\n  \"contrasena\": \"NoEsLaClave1\"\n}"
            }
          }
        },
        {
          "name": "Mis datos",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('es el paciente 70000001', () => pm.expect(pm.response.json().dni).to.eql(pm.collectionVariables.get('dniPaciente')));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/identidad/yo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "identidad",
                "yo"
              ]
            }
          }
        }
      ]
    },
