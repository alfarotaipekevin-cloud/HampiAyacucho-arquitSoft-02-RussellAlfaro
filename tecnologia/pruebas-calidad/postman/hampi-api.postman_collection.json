    {
      "name": "3. Reserva, reprogramación y cancelación (specs 005 y 008)",
      "item": [
        {
          "name": "Liberar citas anteriores del paciente",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "const token = pm.collectionVariables.get('tokenPaciente');",
                  "pm.response.json().forEach(c => pm.sendRequest({ url: pm.collectionVariables.get('baseUrl') + '/citas/' + c.citaId + '/cancelar', method: 'PATCH', header: { Authorization: 'Bearer ' + token } }, () => {}));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "description": "Cancela las citas reservadas de ejecuciones anteriores para no chocar con RN-02 y RN-10.",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/mias?estado=RESERVADA",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas",
                "mias"
              ],
              "query": [
                {
                  "key": "estado",
                  "value": "RESERVADA"
                }
              ]
            }
          }
        },
        {
          "name": "Reservar una cita (HU02)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 201', () => pm.response.to.have.status(201));",
                  "pm.test('EQ-01: responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const f = pm.response.json();",
                  "pm.test('la ficha trae código HAMPI y QR (RN-12)', () => { pm.expect(f.codigo).to.match(/^HAMPI-[0-9A-F]{8}$/); pm.expect(f.qr).to.match(/^data:image\\/png;base64,/); });",
                  "pm.test('queda RESERVADA con 2 reprogramaciones disponibles', () => { pm.expect(f.estado).to.eql('RESERVADA'); pm.expect(f.reprogramacionesRestantes).to.eql(2); });",
                  "pm.collectionVariables.set('citaId', f.citaId);",
                  "pm.collectionVariables.set('codigo', f.codigo);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cupoId\": \"{{cupoId}}\"\n}"
            }
          }
        },
        {
          "name": "El mismo cupo ya no está libre (RN-01)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 409', () => pm.response.to.have.status(409));",
                  "pm.test('con un código de regla de negocio', () => pm.expect(pm.response.json().error.codigo).to.be.oneOf(['CUPO_NO_DISPONIBLE', 'CITA_DUPLICADA']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cupoId\": \"{{cupoId}}\"\n}"
            }
          }
        },
