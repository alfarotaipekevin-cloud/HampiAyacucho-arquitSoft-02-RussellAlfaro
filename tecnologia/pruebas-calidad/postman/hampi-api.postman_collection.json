          }
        },
        {
          "name": "Días con cupos libres",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('EQ-01: responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const fechas = pm.response.json();",
                  "pm.test('hay días disponibles en los próximos 30 (RN-06)', () => pm.expect(fechas.length).to.be.above(0));",
                  "pm.collectionVariables.set('fecha', fechas[1] || fechas[0]);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/cupos/fechas?especialidadId={{especialidadId}}&establecimientoId={{establecimientoId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas",
                "cupos",
                "fechas"
              ],
              "query": [
                {
                  "key": "especialidadId",
                  "value": "{{especialidadId}}"
                },
                {
                  "key": "establecimientoId",
                  "value": "{{establecimientoId}}"
                }
              ]
            }
          }
        },
        {
          "name": "Cupos libres del día (caché Redis, ADR-004)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('EQ-01: responde en menos de 2 s', () => pm.expect(pm.response.responseTime).to.be.below(2000));",
                  "const cupos = pm.response.json();",
                  "pm.test('hay al menos 2 cupos ordenados por hora', () => { pm.expect(cupos.length).to.be.at.least(2); pm.expect(cupos[0].fechaHora <= cupos[1].fechaHora).to.be.true; });",
                  "pm.collectionVariables.set('cupoId', cupos[0].id);",
                  "pm.collectionVariables.set('cupoNuevoId', cupos[cupos.length - 1].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{tokenPaciente}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/citas/cupos?especialidadId={{especialidadId}}&establecimientoId={{establecimientoId}}&fecha={{fecha}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "citas",
                "cupos"
              ],
              "query": [
