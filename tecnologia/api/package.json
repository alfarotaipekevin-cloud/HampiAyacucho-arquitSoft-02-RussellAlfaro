{
  "name": "hampi-api",
  "version": "1.0.0",
  "description": "Backend de Hampi Ayacucho: monolito modular (identidad, portal, citas) con Clean Architecture",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && cp -r src/db/migraciones dist/db/",
    "test": "jest --selectProjects unitarias api calidad",
    "test:integracion": "jest --selectProjects integracion --runInBand",
    "start": "node dist/server.js",
    "dev": "npm run build && node dist/server.js",
    "test:cobertura": "jest --selectProjects unitarias api calidad --coverage",
    "test:calidad": "jest --selectProjects calidad --verbose"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "redis": "^4.7.1",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.5",
    "@types/swagger-ui-express": "^4.1.8",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.6.0"
  }
}
